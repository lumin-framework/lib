{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@lib/*": [
                "packages/lib/src/*"
            ],
            "@core/*": [
                "packages/core/src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}